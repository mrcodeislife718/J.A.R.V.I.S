{
  "name": "jarvis-governed-core",
  "version": "0.1.0",
  "private": true,
  "description": "J.A.R.V.I.S governed AI operating core",
  "type": "module",
  "engines": {
    "node": ">=20.20.2"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "5.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
