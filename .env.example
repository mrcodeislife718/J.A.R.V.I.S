NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Local model endpoints
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
OLLAMA_STRONG_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MODEL_TIMEOUT_MS=120000

# Mission limits
DEFAULT_TOKEN_BUDGET=12000
DEFAULT_MEMORY_BUDGET_MB=4096
MAX_PARALLEL_GENERATIONS=1
HUMAN_APPROVAL_MODE=required-for-high-risk

# Persistent Personal Knowledge Management
# Use memory for zero-setup development or postgres for durable workspaces.
PKM_STORAGE_DRIVER=memory
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
PKM_BLOB_DIR=data/pkm/blobs

# Semantic retrieval is optional. When enabled it uses Ollama embeddings and Qdrant.
PKM_SEMANTIC_INDEX=disabled
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jarvis_pkm

# Reserved for the later distributed mission queue.
REDIS_URL=redis://localhost:6379
