NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Local model endpoints
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
OLLAMA_STRONG_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MODEL_TIMEOUT_MS=120000

# Mission limits
DEFAULT_TOKEN_BUDGET=12000
DEFAULT_MEMORY_BUDGET_MB=4096
MAX_PARALLEL_GENERATIONS=1
HUMAN_APPROVAL_MODE=required-for-high-risk

# Shared PostgreSQL connection for durable domain adapters.
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis

# Persistent Personal Knowledge Management
PKM_STORAGE_DRIVER=memory
PKM_BLOB_DIR=data/pkm/blobs
PKM_SEMANTIC_INDEX=disabled
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jarvis_pkm

# Infrastructure Administration
INFRA_STORAGE_DRIVER=memory
INFRA_AGENT_TOKEN=development-only-change-me
INFRA_STALE_AFTER_MS=90000
INFRA_CPU_WARNING=0.85
INFRA_CPU_CRITICAL=0.95
INFRA_MEMORY_WARNING=0.85
INFRA_MEMORY_CRITICAL=0.95
INFRA_DISK_WARNING=0.85
INFRA_DISK_CRITICAL=0.95
INFRA_BACKUP_STALE_AFTER_MS=604800000
INFRA_CONTROL_URL=http://127.0.0.1:3000
INFRA_AGENT_INTERVAL_MS=30000
INFRA_NODE_ID=
INFRA_NODE_NAME=
INFRA_NODE_ROLE=worker
INFRA_NODE_LABELS=local
INFRA_NODE_CAPABILITIES=ollama,coding
INFRA_ROOT_PATH=/

# Governed Analytics
ANALYTICS_STORAGE_DRIVER=memory
ANALYTICS_MAX_QUERY_ROWS=10000
ANALYTICS_QUERY_TIMEOUT_MS=30000

# Business Operations
BUSINESS_STORAGE_DRIVER=memory

# Content Production
# Publishing is record-only; no social account or publishing credentials are used.
CONTENT_STORAGE_DRIVER=memory

# Reserved for the later distributed mission queue.
REDIS_URL=redis://localhost:6379
